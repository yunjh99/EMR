# Copy to .env on the server. Do not commit real secrets.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
# Exact origin, no trailing slash; multiple origins are comma-separated.
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP
HTTP_PORT=80
# false only for initial HTTP verification. Set true when HTTPS is configured.
AUTH_REFRESH_COOKIE_SECURE=false
# true creates demo_* accounts with password star. Keep false on a public server.
DEMO_DATA_ENABLED=false
